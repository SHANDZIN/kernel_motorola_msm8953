&soc {
	qcom,msm-thermal {
		qcom,config-info = "deen";
	};

	qcom,bcl {
		qcom,bcl-charger-mitigate-enable;
	};

	sys_temp_support {
		compatible = "mmi,sys-temp";
		mmi,temperature-names = "front_temp",
					"back_temp";
		status = "ok";
	};
};

&pm8953_vadc {
	chan@11 {
		label = "chg_therm";
	};

	chan@13 {
		label = "msm_therm";
	};
};

&pmi8950_vadc {
	/delete-node/ chan@d;
};
